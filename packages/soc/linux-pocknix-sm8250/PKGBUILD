# linux-pocknix-sm8250 — the SM8250 kernel as a pacman package; sibling of
# linux-pocknix-sm8550, whose header carries the thin-package rationale.
# arm-efi difference: no boot image, no mkbootimg. GRUB loads /flash/KERNEL as a RAW Image plus a
# separate /flash/boot/grub/<board>.dtb, and the cmdline lives in grub.cfg
# (pocknix-bootloader-sm8250), so the /flash deploy only copies Image + dtbs.
pkgname=linux-pocknix-sm8250
pkgver=7.2.10
pkgrel=4
pkgdesc="SM8250 kernel (stock ${pkgver} + ROCKNIX patch stack, SoC board dtbs) — packaged from 'make kernel' output"
arch=('aarch64')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-only')   # the Linux kernel
# ALARM's generic linux-aarch64 is pre-installed in the base tarball and must go. No
# 'linux-pocknix' provides/replaces: that migration name belongs to the sm8550 lineage.
provides=("linux=${pkgver}")
conflicts=('linux-aarch64')
replaces=('linux-aarch64')
install=linux-pocknix.install
options=('!strip')          # the kernel Image and DTBs must not be stripped

package() {
  local out="${startdir}/staged"     # = build/kernel/out, copied in by scripts/build-packages.sh
  if [ ! -f "${out}/Image" ] || [ ! -f "${out}/kernelrelease" ]; then
    echo "${pkgname}: no staged kernel at ${out}." >&2
    echo "  Run 'make kernel DEVICE=sm8250' first (it produces build/kernel/out), then rebuild this package." >&2
    return 1
  fi
  local kver; kver="$(cat "${out}/kernelrelease")"

  install -Dm644 "${out}/Image" "${pkgdir}/boot/Image"
  install -d "${pkgdir}/boot/dtbs"
  cp "${out}/dtbs/"*.dtb "${pkgdir}/boot/dtbs/"

  install -d "${pkgdir}/usr/lib/modules"
  cp -a "${out}/modroot/lib/modules/${kver}" "${pkgdir}/usr/lib/modules/${kver}"

  # the install scriptlet and the /flash deploy read this to find the modules dir
  install -Dm644 /dev/stdin "${pkgdir}/usr/lib/pocknix/kernelrelease" <<<"${kver}"

}
