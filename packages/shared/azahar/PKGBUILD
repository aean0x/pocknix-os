# azahar — Nintendo 3DS emulator (the maintained Citra successor), vendored from pkgforge-dev's
# aarch64 AppImage: upstream's own AppImage is x86_64-only. pkgforge re-publishes the same Azahar
# version under new date tags, so _tag pins the exact release, not just the version.
pkgname=azahar
pkgver=2126.2
pkgrel=3
_tag=2126.2@2026-10-22_1792689914
pkgdesc="Azahar — 3DS emulator (Citra successor), pkgforge-dev aarch64 AppImage (vendored)"
arch=('aarch64')
url="https://github.com/azahar-emu/azahar"
license=('GPL-2.0-or-later')
depends=('fuse2')
options=('!strip')   # AppImage = ELF runtime + DwarFS payload; strip would corrupt it
_asset=Azahar-${pkgver}-anylinux-aarch64.AppImage
source=("${_asset}::https://github.com/pkgforge-dev/Azahar-AppImage-Enhanced/releases/download/${_tag}/${_asset}"
        'org.azahar_emu.Azahar.desktop')
sha256sums=('49340d1ebbe79fa1b504848d0946884d2c9310d0716c9b7f16ee415221e6e43d'
            'SKIP')
noextract=("${_asset}")

prepare() {
  # --appimage-extract needs no FUSE, so the icon can be pulled in the build chroot.
  cd "${srcdir}"
  chmod u+x "${_asset}"
  rm -rf AppDir
  "./${_asset}" --appimage-extract org.azahar_emu.Azahar.png >/dev/null
  [ -s AppDir/org.azahar_emu.Azahar.png ]  # fail the build if the icon vanished upstream
}

package() {
  # Path is fixed: emu-resolve.sh and es_find_rules.xml both hardcode it.
  install -Dm755 "${srcdir}/${_asset}" "${pkgdir}/opt/pocknix/emulators/azahar/Azahar.AppImage"
  # Same icon name and desktop ID as the source build: existing Steam tiles and menu
  # favourites reference them, and an upgrade never rewrites either.
  install -Dm644 "${srcdir}/AppDir/org.azahar_emu.Azahar.png" \
    "${pkgdir}/usr/share/icons/hicolor/512x512/apps/org.azahar_emu.Azahar.png"
  install -Dm644 "${srcdir}/org.azahar_emu.Azahar.desktop" \
    "${pkgdir}/usr/share/applications/org.azahar_emu.Azahar.desktop"
}
