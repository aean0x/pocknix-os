#!/bin/bash
# X11 (XWayland) whenever the session can authenticate to it: under Wayland ozone a forced scale
# draws scaled but touches land unscaled. Wayland only where X11 would die (ssh, a systemd unit).
plat=()
if [ -n "${DISPLAY:-}" ] && [ -r "${XAUTHORITY:-}" ]; then
  plat=(--ozone-platform=x11)
elif [ -n "${WAYLAND_DISPLAY:-}" ]; then
  plat=(--ozone-platform=wayland)
fi
# SRM won't go below 800x600 logical, so Plasma Mobile's 2-2.5 runs it off a 1080p panel. Ours: the
# largest scale up to 1.7 fitting every screen with 35 px for the title bar; POCKNIX_SRM_SCALE wins.
scale="${POCKNIX_SRM_SCALE:-}"
if [ -z "${scale}" ]; then
  scale="$(for c in /sys/class/drm/card*-*; do
      [ "$(cat "${c}/status" 2>/dev/null)" = connected ] && head -n1 "${c}/modes" 2>/dev/null
    done | awk -Fx 'BEGIN { s = 1.7 }
      NF == 2 { w = ($1 > $2) ? $1 : $2; h = ($1 > $2) ? $2 : $1
                if (w / 800 < s) s = w / 800
                if (h / 635 < s) s = h / 635 }
      END { printf "%.2f\n", int(s * 20 + 1e-9) / 20 }')"
fi
# The env scrub: a Steam launch injects LD_PRELOAD and its runtime libraries, which break the
# bundled Electron. --no-sandbox: chrome-sandbox needs setuid root, impossible in the squashfs.
exec env -u LD_PRELOAD -u LD_LIBRARY_PATH FUSERMOUNT_PROG=/usr/bin/fusermount \
  /opt/pocknix/steam-rom-manager/Steam-ROM-Manager.AppImage --no-sandbox \
  "--force-device-scale-factor=${scale}" "${plat[@]}" "$@"
