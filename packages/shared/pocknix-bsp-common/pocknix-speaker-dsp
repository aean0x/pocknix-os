#!/bin/sh
# pocknix-speaker-dsp on|off - switch the speaker DSP for every logged-in user (as root).
# The switch file outlives reboots; the unit's ExecCondition reads it at every start.
STATE=/var/lib/pocknix/speaker-dsp
case "$1" in
  on) verb=restart ;;
  off) verb=stop ;;
  *) echo "usage: pocknix-speaker-dsp on|off" >&2; exit 2 ;;
esac
mkdir -p "${STATE%/*}" && printf '%s\n' "$1" > "${STATE}.tmp" && mv "${STATE}.tmp" "${STATE}" || exit 1
loginctl list-users --no-legend 2>/dev/null | awk '$1 >= 1000 { print $2 }' | while read -r u; do
  systemctl --machine="${u}@.host" --user "${verb}" pocknix-speaker-dsp.service 2>/dev/null
done
exit 0
