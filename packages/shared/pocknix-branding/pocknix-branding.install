# Arch's plymouth package owns /etc/plymouth/plymouthd.conf, so the theme cannot ship as a
# packaged file. The image overlay covers fresh installs; fielded ones only reach the new
# boot splash through here on -Syu. Only spinner is rewritten, so a user's own choice stands.
_pocknix_set_plymouth_theme() {
  local conf=/etc/plymouth/plymouthd.conf
  [ -f "${conf}" ] || return 0
  sed -i 's/^Theme=spinner$/Theme=pocknix/' "${conf}"
}

# The wallpaper seed wrote this path and the wallpaper is gone: a dangling Image= paints Plasma's
# white fill on every desktop start. Only that exact line goes; a user's own pick names another path.
_pocknix_drop_seeded_wallpaper() {
  local rc line='Image=file:///usr/share/wallpapers/PocknixOS'
  for rc in ${POCKNIX_HOME_ROOT:-/home}/*/.config/plasma-org.kde.plasma.mobileshell-appletsrc; do
    # sed -i would replace a symlinked (dotfile-managed) config with a plain file.
    [ -f "${rc}" ] && [ ! -L "${rc}" ] || continue
    # Checked first so a config without the line is never rewritten.
    grep -qxF "${line}" "${rc}" || continue
    sed -i "\\|^${line}\$|d" "${rc}"
  done
}

post_install() {
  _pocknix_set_plymouth_theme
}

post_upgrade() {
  _pocknix_set_plymouth_theme
  if [ "$(vercmp "$2" 0.1.0-4)" -lt 0 ]; then
    _pocknix_drop_seeded_wallpaper
  fi
}
