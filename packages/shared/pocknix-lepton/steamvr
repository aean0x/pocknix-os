#!/bin/bash
# Lepton asks `steamvr` (a Steam Frame tool) for three directories to bind-mount into its
# container, and fails to start when any comes back empty.
set -euo pipefail

base="${XDG_DATA_HOME:-${HOME}/.local/share}/lepton/steamvr"
case "${1:-}" in
  path)       dir="${base}/runtime" ;;
  logpath)    dir="${base}/logs" ;;
  configpath) dir="${base}/config" ;;
  *) echo "usage: steamvr path|logpath|configpath" >&2; exit 2 ;;
esac
mkdir -p "${dir}"
printf '%s\n' "${dir}"
