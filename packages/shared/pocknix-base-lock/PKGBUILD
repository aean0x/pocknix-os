# pocknix-base-lock — ships the base snapshot's package manifest and IS the device's
# record of which base it runs: the repo URL carries no id, so pkgver (the snapshot id)
# is the only thing that answers "which base am I on?". Regenerated by `make snapshot`.
pkgname=pocknix-base-lock
# Parsed from the lockfile header so version and manifest cannot disagree. Dots are part
# of the id (same-day re-snapshots are 20260810.1): truncate them and one pkgver ends up
# published twice with different contents.
pkgver=$(sed -n 's/^#.*snapshot \([0-9][0-9.]*\).*/\1/p' "${startdir}/pocknix-base.lock" | head -1)
pkgrel=1
pkgdesc="Manifest and version stamp of the frozen pocknix ALARM base snapshot"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
# Base 20260826 renamed mbedtls -> mbedtls3 with no conflicts= upstream: replaces=
# drops the old copy in the same -Syu (default-yes under --noconfirm; conflicts= is not).
# Base 20261023 drops opencv (kquickimageeditor 0.7 no longer needs it) and with it
# gst-plugins-base, whose exact-version gstreamer pins would block the gstreamer upgrade.
# Versioned: only the old base's builds go. Rolling devices hold ALARM's newer ones as real
# deps, and an unversioned replace would fail every -Syu there. Orphans whose ALARM version
# never moved (blas, lapack, ...) cannot be told apart, so they stay.
replaces=('mbedtls' 'gst-plugins-base<1.28.8' 'opencv<5.0.0-10' 'verdict<1.4.5-3')
conflicts=('mbedtls')
source=('pocknix-base.lock')
sha256sums=('SKIP')

package() {
  install -Dm644 "${srcdir}/pocknix-base.lock" \
    "${pkgdir}/usr/share/pocknix/pocknix-base.lock"
}
