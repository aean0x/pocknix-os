# pocknix-base-lock — ships the base snapshot's package manifest and IS the device's
# record of which base it runs: the repo URL carries no id, so pkgver (the snapshot id)
# is the only thing that answers "which base am I on?". Regenerated by `make snapshot`.
pkgname=pocknix-base-lock
# Parsed from the lockfile header so version and manifest cannot disagree. Keep the dots: same-day
# re-snapshots are 20260810.1, and truncating them publishes one pkgver twice.
pkgver=$(sed -n 's/^#.*snapshot \([0-9][0-9.]*\).*/\1/p' "${startdir}/pocknix-base.lock" | head -1)
pkgrel=1
pkgdesc="Manifest and version stamp of the frozen pocknix ALARM base snapshot"
arch=('any')
url="https://github.com/shuuri-labs/pocknix-os"
license=('GPL-2.0-or-later')
# Drops what a base cut removed (replaces= is default-yes under --noconfirm, conflicts= is not).
# Versioned, so rolling devices keep ALARM's newer copies: an unversioned replace fails their -Syu.
replaces=('mbedtls' 'gst-plugins-base<1.28.8' 'opencv<5.0.0-10' 'verdict<1.4.5-3')
conflicts=('mbedtls')
source=('pocknix-base.lock')
sha256sums=('SKIP')

package() {
  install -Dm644 "${srcdir}/pocknix-base.lock" \
    "${pkgdir}/usr/share/pocknix/pocknix-base.lock"
}
