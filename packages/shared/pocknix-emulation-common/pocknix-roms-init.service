[Unit]
Description=pocknix: create ~/ROMs tree and seed emulator configs on first login
After=graphical-session-pre.target
# Never PartOf= the session target: pocknix-session stops it before every compositor start,
# boot included, and that stop would kill this mid-seed.

[Service]
Type=oneshot
ExecStart=/usr/bin/pocknix-roms-init
RemainAfterExit=yes

[Install]
WantedBy=default.target
