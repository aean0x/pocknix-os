[Unit]
Description=pocknix game mode session
# graphical-session.target refuses a manual start, so bind to it; pocknix-session stops it at every
# switch, which stops this too. Members join via .wants/ and PartOf=this target.
BindsTo=graphical-session.target
Before=graphical-session.target
Wants=graphical-session-pre.target
After=graphical-session-pre.target
