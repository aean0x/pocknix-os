# Dolphin graphics seed (-> ~/.config/dolphin-emu/GFX.ini).
# ShaderCompilationMode 3 (async, skip drawing): the default synchronous compile stalls whole
# frames on every first-seen effect, at the cost of brief object pop-in. The widescreen hack is
# written off explicitly so it stays off if a future build flips the default.
[Settings]
InternalResolution = 2
ShaderCompilationMode = 3
wideScreenHack = False
