# dolphin-emu — GameCube/Wii emulator, vendored from upstream's official arm64 AppImage. Only
# master dev builds ship one (releases are Flatpak-only), so this tracks dev builds.
pkgname=dolphin-emu
_build=2609-119
pkgver=${_build/-/.}
pkgrel=1
pkgdesc="GameCube / Wii emulator (official arm64 dev AppImage, vendored)"
arch=('aarch64')
url="https://dolphin-emu.org"
license=('GPL-2.0-or-later')
depends=('fuse2')
options=('!strip')   # AppImage = ELF runtime + squashfs payload; strip would corrupt it
_asset=dolphin-master-${_build}-arm64.AppImage
# The CDN folder is the first two byte pairs of sha256 of the asset NAME:
# printf %s <asset> | sha256sum -> 0594... -> 05/94.
_dir=05/94
source=("${_asset}::https://dl.dolphin-emu.org/builds/${_dir}/${_asset}"
        'dolphin-emu.desktop')
sha256sums=('39921f96f0c4b38c92a9a6a5924a176b1c6697fd03d8fa402664d8ea46dce6b1'
            'SKIP')
noextract=("${_asset}")

prepare() {
  # --appimage-extract needs no FUSE, so the icons can be pulled in the build chroot.
  cd "${srcdir}"
  chmod u+x "${_asset}"
  rm -rf squashfs-root
  "./${_asset}" --appimage-extract 'usr/share/icons/hicolor/*' >/dev/null
  # fail the build if the icons vanished upstream
  [ -s squashfs-root/usr/share/icons/hicolor/256x256/apps/dolphin-emu.png ]
  [ -s squashfs-root/usr/share/icons/hicolor/scalable/apps/dolphin-emu.svg ]
}

package() {
  # Path is fixed: emu-resolve.sh and es_find_rules.xml both hardcode it.
  install -Dm755 "${srcdir}/${_asset}" "${pkgdir}/opt/pocknix/emulators/dolphin/dolphin-emu.AppImage"
  # Same icon name and desktop ID as the source build: existing Steam tiles and menu
  # favourites reference them, and an upgrade never rewrites either.
  local i="${srcdir}/squashfs-root/usr/share/icons/hicolor"
  install -Dm644 "${i}/256x256/apps/dolphin-emu.png" "${pkgdir}/usr/share/icons/hicolor/256x256/apps/dolphin-emu.png"
  install -Dm644 "${i}/scalable/apps/dolphin-emu.svg" "${pkgdir}/usr/share/icons/hicolor/scalable/apps/dolphin-emu.svg"
  install -Dm644 "${srcdir}/dolphin-emu.desktop" "${pkgdir}/usr/share/applications/dolphin-emu.desktop"
}
