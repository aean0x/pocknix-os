[Unit]
Description=pocknix sm8250 LPASS audio probe heal
# The script waits for the adsp itself and only needs modules/udev; audio consumers pick the card
# up via hotplug, so no ordering against them.
After=basic.target

[Service]
Type=oneshot
ExecStart=/usr/lib/pocknix/pocknix-sm8250-audio-heal
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
